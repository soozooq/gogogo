<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque map controls remain readable on light and dark map tiles, in both themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/twt_map_control_surface" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/twt_map_control_stroke" />
</shape>
