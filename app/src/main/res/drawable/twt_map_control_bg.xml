<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque, contrast-safe map surface with touch feedback in both DayNight themes. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30233E75">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/twt_map_control_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/twt_map_control_stroke" />
        </shape>
    </item>
</ripple>
