<?xml version="1.0" encoding="utf-8"?>
<!-- Companion chip for the existing mock-action FAB. Theme-aware, never changes ServiceGo. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/gogogo_primary_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gogogo_surface" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/gogogo_border" />
        </shape>
    </item>
</ripple>
