<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.tencent.mm" />
        <!-- Only for opening the user-selected app in a manual location comparison. -->
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.tencent.map" />
        <package android:name="com.sankuai.meituan" />
    </queries>

    <!-- Android Q 新增的权限。允许用户授予对两个不同范围的位置访问权限：在使用中（仅限前景）或始终（前景和后台） -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 允许一个程序访问CellID或WiFi热点来获取粗略的位置 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 通过GPS得到精确位置 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 允许程序访问Wi-Fi网络状态信息 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 允许程序访问有关GSM网络信息 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 允许程序改变Wi-Fi连接状态 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <uses-permission android:name="android.permission.REPLACE_EXISTING_PACKAGE"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- 允许程序打开网络套接字 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.INTERACT_ACROSS_PROFILES"
        tools:ignore="ProtectedPermissions" />
    <!-- 允许挂载和反挂载文件系统可移动存储 -->
    <uses-permission
        android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS"
        tools:ignore="ProtectedPermissions" />
    <!-- 允许程序读取底层系统日志文件 -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 允许访问振动设备 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 允许使用PowerManager的 WakeLocks保持进程在休眠时从屏幕消失 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 允许程序读取或写入系统设置 -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 允许程序创建模拟位置提供用于测试 -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />

    <application
        android:name=".GoApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:launchMode="singleInstance"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- 腾讯地图 Key -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="${TENCENT_MAP_KEY}" />

        <service
            android:exported="false"
            android:foregroundServiceType="location"
            android:name="com.zcshou.service.ServiceGo" />

        <!-- Private same-UID read-only runtime probe, located in main process. -->
        <provider
            android:name=".LabRuntimeStatusProvider"
            android:authorities="${applicationId}.lab.runtime"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- The actual launcher is the key-free OpenFreeMap Tianwaitian home.
             SimpleMockActivity stays internal, preserving VPN/Shizuku controls. -->
        <activity
            android:name=".TianwaitianHomeActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SimpleMockActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabMapActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabPlacePickerActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".TianwaitianSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabHubActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabCrossAppLocationActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabPrivacyAuditActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabSimAttributionActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabAutoDiagnosticActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabRecoveryTriageActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabQuickCheckActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LabDiagnosticsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".SandboxLabActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".PolicyLabActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".CrossProfileObservatoryActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- Dedicated test IPC process; same app UID, distinct PID, not a guest sandbox. -->
        <service
            android:name=".virtualv0.VirtualContainerV0IpcService"
            android:exported="false"
            android:process=":virtualv0" />
        <!-- Slot B has a different PID but the same app UID as slot A. -->
        <service
            android:name=".virtualv0.VirtualContainerV0IpcServiceB"
            android:exported="false"
            android:process=":virtualv0b" />

        <activity
            android:name=".VirtualContainerV0Activity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
        <!-- V1: registered HOST proxy; delegates lifecycle messages into trusted fixture APK. -->
        <activity
            android:name=".VirtualContainerV1ProxyActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- V2: only registered HOST Activities, never installs/starts guest component. -->
        <activity
            android:name=".VirtualContainerV2Activity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".VirtualContainerV2ProxyActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- Stage 2: local host proxy for trusted guest session state machine;
             never exports the component or installs the guest APK. -->
        <activity
            android:name=".VirtualContainerV2SessionActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".IsolatedCapsuleLabActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ScenarioLabActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".MotionAuditActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".HeadingLabActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".LocationCompatibilityActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".TencentLocationProbeActivity"
            android:exported="false"
            android:process=":consumer"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ConsumerLocationProbeActivity"
            android:exported="false"
            android:process=":consumer"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".CompatibilitySessionActivity"
            android:exported="false"
            android:process=":consumer"
            android:theme="@style/AppTheme.NoActionBar" />

        <service
            android:name=".CompatibilitySessionService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:process=":consumer" />

        <receiver
            android:name=".LabDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/lab_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleInstance"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_settings"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".HistoryActivity"
            android:label="@string/app_history"
            android:exported="false" />

        <activity
            android:name=".MiniProgramTestActivity"
            android:label="@string/nav_menu_mini_program_test"
            android:exported="false" />

    </application>

</manifest>