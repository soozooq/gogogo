@@ -0,0 +1,116 @@
+package top.niunaijun.bcore.utils.compat;
+
+import android.location.Location;
+import android.os.Build;
+import android.os.CancellationSignal;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.RemoteException;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.Collections;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Framework Binder contracts, without shipping replacement android.* interfaces. */
+public final class LocationCallbackCompat {
+    private LocationCallbackCompat() { }
+
+    public interface Source {
+        Location get();
+    }
+
+    public static IInterface findInterface(Object[] args, String name) throws Exception {
+        Class<?> type = Class.forName(name);
+        for (Object value : args) {
+            if (type.isInstance(value)) return (IInterface) value;
+        }
+        throw new IllegalArgumentException("Missing " + name);
+    }
+
+    public static long requestLong(Object request, String name, long fallback) {
+        if (request == null) return fallback;
+        try {
+            return ((Number) request.getClass().getMethod(name).invoke(request)).longValue();
+        } catch (ReflectiveOperationException e) {
+            return fallback;
+        }
+    }
+
+    public static void deliverListener(IBinder binder, Location location) throws Exception {
+        Class<?> listenerClass = Class.forName("android.location.ILocationListener");
+        Object listener = Class.forName("android.location.ILocationListener$Stub")
+                .getMethod("asInterface", IBinder.class).invoke(null, binder);
+        if (Build.VERSION.SDK_INT >= 31) {
+            invoke(listenerClass.getMethod("onLocationChanged", java.util.List.class,
+                    Class.forName("android.os.IRemoteCallback")), listener,
+                    Collections.singletonList(location), null);
+        } else {
+            invoke(listenerClass.getMethod("onLocationChanged", Location.class), listener, location);
+        }
+    }
+
+    /** Return the real framework ICancellationSignal, never a Location as a return value. */
+    public static Object requestCurrent(IInterface callback, Source source, Handler handler)
+            throws Exception {
+        Class<?> transportType = Class.forName("android.os.ICancellationSignal");
+        Object transport = CancellationSignal.class.getMethod("createTransport").invoke(null);
+        CancellationSignal cancellation = (CancellationSignal) CancellationSignal.class
+                .getMethod("fromTransport", transportType).invoke(null, transport);
+        CurrentRequest request = new CurrentRequest(callback, source, handler);
+        cancellation.setOnCancelListener(request::finish);
+        callback.asBinder().linkToDeath(request, 0);
+        if (!handler.post(request)) request.finish();
+        return transport;
+    }
+
+    private static void invoke(Method method, Object receiver, Object... args) throws Exception {
+        try {
+            method.invoke(receiver, args);
+        } catch (InvocationTargetException e) {
+            Throwable cause = e.getCause();
+            if (cause instanceof Exception) throw (Exception) cause;
+            throw e;
+        }
+    }
+
+    private static final class CurrentRequest implements Runnable, IBinder.DeathRecipient {
+        private final IInterface callback;
+        private final Source source;
+        private final Handler handler;
+        private final AtomicBoolean finished = new AtomicBoolean();
+
+        CurrentRequest(IInterface callback, Source source, Handler handler) {
+            this.callback = callback;
+            this.source = source;
+            this.handler = handler;
+        }
+
+        @Override public void run() {
+            if (!finished.compareAndSet(false, true)) return;
+            try {
+                invoke(Class.forName("android.location.ILocationCallback")
+                        .getMethod("onLocation", Location.class), callback, source.get());
+            } catch (Exception e) {
+                android.util.Log.w("BBLocation", "Single location callback failed", e);
+            } finally {
+                unlink();
+            }
+        }
+
+        void finish() {
+            if (finished.compareAndSet(false, true)) {
+                handler.removeCallbacks(this);
+                unlink();
+            }
+        }
+
+        private void unlink() {
+            try { callback.asBinder().unlinkToDeath(this, 0); }
+            catch (java.util.NoSuchElementException ignored) { }
+        }
+
+        @Override public void binderDied() { finish(); }
+    }
+}
