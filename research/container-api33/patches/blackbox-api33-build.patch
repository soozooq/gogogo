@@ -0,0 +1,86 @@
+package top.niunaijun.bcore.core.system.location;
+
+import android.location.Location;
+import android.os.Bundle;
+import android.os.SystemClock;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Bounded, volatile counters for virtual delivery only. No location objects are retained. */
+final class ConsumerLocationStats {
+    static final String SCOPE = "CORE_MEMORY_VIRTUAL_PREPARATION_AND_BINDER_SEND_NOT_SDK_ADOPTION";
+    private static final int LIMIT = 16;
+    private final Map<String, Bundle> records = new LinkedHashMap<>();
+
+    private static String key(int user, String pkg) {
+        return pkg == null || pkg.length() > 255 ? null : user + ":" + pkg;
+    }
+
+    private static String provider(String value) {
+        return "gps".equals(value) ? "gps" : "network".equals(value) ? "network"
+                : "passive".equals(value) ? "passive" : "other";
+    }
+
+    private Bundle record(int user, String pkg) {
+        String key = key(user, pkg);
+        if (key == null) return null;
+        Bundle value = records.get(key);
+        if (value == null) {
+            if (records.size() == LIMIT) records.remove(records.keySet().iterator().next());
+            value = new Bundle();
+            value.putLong("first_event_elapsed_ms", SystemClock.elapsedRealtime());
+            records.put(key, value);
+        }
+        return value;
+    }
+
+    private static void increment(Bundle value, String name) {
+        long previous = value.getLong(name);
+        value.putLong(name, previous == Long.MAX_VALUE ? previous : previous + 1);
+        value.putLong("last_event_elapsed_ms", SystemClock.elapsedRealtime());
+    }
+
+    synchronized void prepared(int user, String pkg, String provider, boolean current,
+                               boolean present, int callerPid) {
+        Bundle value = record(user, pkg);
+        if (value == null) return;
+        increment(value, present ? (current ? "current_" : "cache_") + provider(provider) + "_prepared"
+                : "missing_sample_count");
+        value.putInt("last_preparation_caller_pid", callerPid);
+    }
+
+    synchronized void registered(int user, String pkg, String provider, int receiverPid) {
+        Bundle value = record(user, pkg);
+        if (value == null) return;
+        increment(value, "stream_" + provider(provider) + "_registered");
+        value.putInt("last_stream_receiver_pid", receiverPid);
+    }
+
+    synchronized void sent(int user, String pkg, String provider, int receiverPid, Location sample) {
+        Bundle value = record(user, pkg);
+        if (value == null) return;
+        increment(value, "stream_" + provider(provider) + "_transaction_returned");
+        value.putInt("last_stream_receiver_pid", receiverPid);
+        value.putBoolean("last_stream_mock", sample.isFromMockProvider());
+        value.putBoolean("last_stream_synthetic", sample.getExtras() != null
+                && sample.getExtras().getBoolean("tianwaitian.synthetic"));
+    }
+
+    synchronized void failed(int user, String pkg) {
+        Bundle value = record(user, pkg);
+        if (value != null) increment(value, "stream_failure_count");
+    }
+
+    synchronized Bundle snapshot(int user, String pkg) {
+        String key = key(user, pkg);
+        Bundle value = key == null ? null : records.get(key);
+        Bundle copy = value == null ? new Bundle() : new Bundle(value);
+        copy.putString("scope", SCOPE);
+        copy.putBoolean("present", value != null);
+        copy.putLong("last_event_age_ms", value == null ? -1
+                : Math.max(0, SystemClock.elapsedRealtime() - value.getLong("last_event_elapsed_ms")));
+        copy.putInt("maximum_profiles", LIMIT);
+        return copy;
+    }
+}
