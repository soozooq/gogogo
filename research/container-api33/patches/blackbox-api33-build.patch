@@ -0,0 +1,85 @@
+package top.niunaijun.bcore.utils.compat;
+
+import android.location.GnssStatus;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.IInterface;
+import android.os.RemoteException;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** API31+ virtual-session status. No satellites, first-fix claim, NMEA, or raw measurements. */
+public final class VirtualGnssStatus {
+    private static final Map<IBinder, Registration> registrations = new HashMap<>();
+
+    public interface Mode { boolean enabled(); }
+
+    private VirtualGnssStatus() { }
+
+    public static void register(IInterface callback, Handler handler, Mode mode) throws RemoteException {
+        Registration record = new Registration(callback, handler, mode);
+        synchronized (registrations) {
+            remove(callback.asBinder());
+            callback.asBinder().linkToDeath(record, 0);
+            registrations.put(callback.asBinder(), record);
+            if (!handler.post(record)) remove(callback.asBinder());
+        }
+    }
+
+    public static boolean remove(IBinder binder) {
+        synchronized (registrations) {
+            Registration record = registrations.remove(binder);
+            if (record == null) return false;
+            record.handler.removeCallbacks(record);
+            try { binder.unlinkToDeath(record, 0); }
+            catch (java.util.NoSuchElementException ignored) { }
+            return true;
+        }
+    }
+
+    private static final class Registration implements Runnable, IBinder.DeathRecipient {
+        final IInterface callback;
+        final Handler handler;
+        final Mode mode;
+        boolean started;
+
+        Registration(IInterface callback, Handler handler, Mode mode) {
+            this.callback = callback;
+            this.handler = handler;
+            this.mode = mode;
+        }
+
+        @Override public void binderDied() { remove(callback.asBinder()); }
+
+        @Override public void run() {
+            synchronized (registrations) {
+                if (registrations.get(callback.asBinder()) != this) return;
+            }
+            try {
+                Class<?> contract = Class.forName("android.location.IGnssStatusListener");
+                if (!mode.enabled() || !callback.asBinder().isBinderAlive()) {
+                    if (started && callback.asBinder().isBinderAlive()) {
+                        contract.getMethod("onGnssStopped").invoke(callback);
+                    }
+                    remove(callback.asBinder());
+                    return;
+                }
+                if (!started) {
+                    contract.getMethod("onGnssStarted").invoke(callback);
+                    started = true;
+                }
+                // Zero satellites is intentional: location samples are synthetic, not GNSS fixes.
+                contract.getMethod("onSvStatusChanged", GnssStatus.class)
+                        .invoke(callback, new GnssStatus.Builder().build());
+                synchronized (registrations) {
+                    if (registrations.get(callback.asBinder()) == this
+                            && !handler.postDelayed(this, 1000)) remove(callback.asBinder());
+                }
+            } catch (Exception error) {
+                android.util.Log.w("BBLocation", "Virtual GNSS status callback failed", error);
+                remove(callback.asBinder());
+            }
+        }
+    }
+}
