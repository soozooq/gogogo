<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.soozooq.tianwaitian.locationconsumer">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application android:label="定位消费者（自有测试）" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <uses-library android:name="org.apache.http.legacy" android:required="false" />
        <activity android:name=".StartupContractActivity" android:exported="true" />
        <service android:name=".StartupContractService" android:exported="false" />
        <activity android:name=".ReadOnlyUiFixtureActivity" android:exported="true" />
        <activity android:name=".LocationActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
