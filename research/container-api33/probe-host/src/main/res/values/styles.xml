<resources>
    <style name="PreviewTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/preview_primary</item>
        <item name="android:windowBackground">@color/preview_background</item>
        <item name="android:statusBarColor">@color/preview_background</item>
        <item name="android:navigationBarColor">@color/preview_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/preview_ink</item>
        <item name="android:textColorSecondary">@color/preview_muted</item>
    </style>
    <style name="PreviewText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/preview_ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="PreviewCaption" parent="PreviewText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/preview_muted</item>
    </style>
    <style name="PreviewHeading" parent="PreviewText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PreviewButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/preview_button_ink</item>
        <item name="android:background">@drawable/preview_secondary_button</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PreviewInput" parent="android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/preview_ink</item>
        <item name="android:textColorHint">@color/preview_muted</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/preview_input</item>
        <item name="android:selectAllOnFocus">true</item>
    </style>
</resources>
