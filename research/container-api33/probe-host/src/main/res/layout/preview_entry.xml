<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:id="@+id/preview_root" android:orientation="vertical" android:background="@color/preview_background"
    android:focusableInTouchMode="true">
    <LinearLayout android:id="@+id/preview_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="16dp" android:paddingBottom="12dp">
        <TextView style="@style/PreviewCaption" android:text="天外天  /  应用空间" />
        <TextView style="@style/PreviewHeading" android:layout_marginTop="6dp"
            android:textSize="24sp" android:text="原版应用预览" android:accessibilityHeading="true" />
        <TextView style="@style/PreviewCaption" android:layout_marginTop="6dp"
            android:text="导入一次，选点后打开。" />
    </LinearLayout>
    <ScrollView android:id="@+id/preview_form" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:background="@drawable/preview_card">
                <TextView style="@style/PreviewHeading" android:text="01  选择应用" android:accessibilityHeading="true" />
                <Spinner android:id="@id/guest_choice" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:contentDescription="选择要预览的原版应用" android:layout_marginTop="4dp" />
                <LinearLayout android:id="@+id/import_actions" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@id/import_installed_guest" style="@style/PreviewButton"
                        android:layout_width="0dp" android:layout_weight="1" android:text="导入已装应用" />
                    <Space android:id="@+id/import_gap" android:layout_width="8dp" android:layout_height="8dp" />
                    <Button android:id="@id/import_guest" style="@style/PreviewButton"
                        android:layout_width="0dp" android:layout_weight="1" android:text="选择原版 APK" />
                </LinearLayout>
                <Button android:id="@+id/download_original" style="@style/PreviewButton"
                    android:layout_marginTop="4dp" android:background="?android:attr/selectableItemBackground"
                    android:text="获取对应版本的原版 APK  ↗" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/coordinate_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:orientation="vertical" android:padding="16dp" android:background="@drawable/preview_card">
                <TextView style="@style/PreviewHeading" android:text="02  确认地点" android:accessibilityHeading="true" />
                <TextView android:id="@+id/coordinate_hint" style="@style/PreviewCaption"
                    android:layout_marginTop="5dp" android:text="目标坐标 · WGS-84" />
                <LinearLayout android:id="@+id/coordinate_fields" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/PreviewCaption" android:text="纬度" android:labelFor="@id/target_latitude" />
                        <EditText android:id="@id/target_latitude" style="@style/PreviewInput"
                            android:layout_marginTop="6dp" android:hint="−90～90" android:singleLine="true"
                            android:inputType="numberDecimal|numberSigned" android:imeOptions="actionNext"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                    <Space android:id="@+id/coordinate_gap" android:layout_width="10dp" android:layout_height="10dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/PreviewCaption" android:text="经度" android:labelFor="@id/target_longitude" />
                        <EditText android:id="@id/target_longitude" style="@style/PreviewInput"
                            android:layout_marginTop="6dp" android:hint="−180～180" android:singleLine="true"
                            android:inputType="numberDecimal|numberSigned" android:imeOptions="actionDone"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:paddingTop="16dp">
                <TextView style="@style/PreviewCaption" android:text="当前状态" android:accessibilityHeading="true" />
                <TextView android:id="@id/import_status" style="@style/PreviewText"
                    android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" android:textIsSelectable="true" />
                <TextView style="@style/PreviewCaption" android:layout_marginTop="10dp"
                    android:text="使用选点合成位置，应用实际位置效果待确认。" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp"
        android:paddingBottom="12dp" android:orientation="vertical" android:background="@color/preview_surface">
        <Button android:id="@id/open_guest" style="@style/PreviewButton"
            android:minHeight="52dp" android:textSize="16sp" android:text="应用坐标并打开"
            android:background="@drawable/preview_primary_button" android:textColor="@color/preview_primary_ink" />
        <LinearLayout android:id="@+id/preview_actions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@id/stop_guest" style="@style/PreviewButton"
                android:layout_width="0dp" android:layout_weight="1" android:text="停止预览" />
            <Space android:id="@+id/preview_action_gap" android:layout_width="8dp" android:layout_height="8dp" />
            <Button android:id="@id/copy_preview_feedback" style="@style/PreviewButton"
                android:layout_width="0dp" android:layout_weight="1" android:text="一键复制反馈" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
