<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/guest_panel_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <android.widget.TextView
        android:id="@+id/guest_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/guest_panel_title"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp" />
    <android.widget.ImageView
        android:id="@+id/guest_image"
        android:layout_width="72dp"
        android:layout_height="42dp"
        android:contentDescription="@string/guest_image_description"
        android:src="@drawable/guest_mark" />
    <android.widget.TextView
        android:id="@+id/guest_counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />
    <android.widget.Button
        android:id="@+id/guest_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/guest_tap_button" />
</LinearLayout>
