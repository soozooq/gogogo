<?xml version="1.0" encoding="utf-8"?>
<android.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/demo_background">
    <android.widget.TextView
        android:id="@+id/demo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/demo_title"
        android:textColor="@color/demo_foreground"
        android:textStyle="bold"
        android:textSize="21sp" />
    <android.widget.TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/demo_description"
        android:textColor="@color/demo_foreground"
        android:textSize="15sp" />
    <android.widget.LinearLayout
        android:id="@+id/demo_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <android.widget.TextView
            android:id="@+id/demo_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/demo_foreground"
            android:textSize="18sp" />
        <android.widget.Button
            android:id="@+id/demo_increment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_increment" />
        <android.widget.EditText
            android:id="@+id/demo_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="@string/demo_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:maxLines="5"
            android:minLines="3"
            android:textColor="@color/demo_foreground"
            android:textColorHint="@color/demo_hint"
            android:textSize="16sp" />
        <android.widget.Button
            android:id="@+id/demo_open_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/demo_open_details" />
    </android.widget.LinearLayout>
    <android.widget.LinearLayout
        android:id="@+id/demo_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <android.widget.TextView
            android:id="@+id/demo_details_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/demo_foreground"
            android:textIsSelectable="true"
            android:textSize="17sp" />
        <android.widget.Button
            android:id="@+id/demo_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/demo_back" />
    </android.widget.LinearLayout>
</android.widget.LinearLayout>
